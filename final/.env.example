# B2B SaaS local configuration
SECRET_KEY=replace-this-in-production

# NAVER Commerce API
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
# 내 스토어 애플리케이션은 반드시 SELF이며 account_id를 보내지 않습니다.
NAVER_COMMERCE_TOKEN_TYPE=SELF
# 커머스솔루션 판매자 연동(SELLER)에서만 판매자 UID를 넣습니다. 내 스토어는 비워둡니다.
NAVER_COMMERCE_ACCOUNT_ID=

# Coupang Open API
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
